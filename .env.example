# Database Connection (Default: local SQLite for zero-friction local run; replace with Supabase/Neon PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@db.supabase.co:5432/postgres?sslmode=require"

# JWT Secret for Admin Authentication
JWT_SECRET="e-waste-chittagong-secure-production-jwt-secret-key-32chars"

# Node Environment
NODE_ENV="development"

# Base Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
