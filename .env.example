# ==============================================================================
# E-Waste Chittagong — Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# 1. Database Connection String
# Option A (Local / Persistent VPS): SQLite
DATABASE_URL="file:./dev.db"

# Option B (Serverless / Cloud Production): Managed PostgreSQL (e.g. Supabase, Neon, Render)
# DATABASE_URL="postgresql://ewc_admin:your_secure_db_password@db.supabase.co:5432/postgres?sslmode=require"

# 2. Authentication Secret (REQUIRED IN PRODUCTION)
# Must be at least 32 characters long. In production, generate using: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-64-character-cryptographic-secret-key-for-production"

# 3. Application Environment
NODE_ENV="development" # Set to "production" in live deployment

# 4. Canonical Site URL (Used for sitemaps, robots.txt, OpenGraph, and hreflang metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="https://ewastechittagong.com"

# 5. Cloudinary Media Storage (Photos and Videos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# 6. Optional Seeding Environment Flags (Only if automated bootstrapping is needed in CI/CD)
# SEED_ADMIN_EMAIL="admin@ewastechittagong.com"
# SEED_ADMIN_PASSWORD="YourStrongPassword123!"
# Note: For production, provision the administrator manually via: node scripts/create-admin.mjs

